{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!coverage",
      "!node_modules",
      "!fixtures/local",
      "!fixtures/synthetic",
      "!data/calendar"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": ["model/normal.ts", "tests/model/normal.test.ts", "tests/model/black76.test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noPrecisionLoss": "off"
          }
        }
      }
    }
  ]
}
